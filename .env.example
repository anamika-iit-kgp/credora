# Copy to .env.<name> (for example .env.credora), fill in,
# then run make deploy ENV=<name>   (or python deploy/credora.py deploy --env <name>)
# Never commit filled-in env files. See docs/PORTING.md.
# Database, API and Exasol passwords are generated per deployment and kept in
# AWS Secrets Manager, so you don't set them here.

# AWS. The account is whatever this CLI profile is logged in to (required).
AWS_PROFILE=
AWS_REGION=ap-south-1
PROJECT=credora

# Domain, a Route 53 hosted zone in the same account (required). This is Sapphire Bank's side,
# with the web app at the root (www redirects), plus docs., video. and ppt.
DOMAIN=

# Optional second Route 53 zone for the 3rd party data APIs. cibil., gst. and aa. become
# HTTPS relays to the mock CIBIL, GSTN and Account Aggregator APIs, and Exasol's UDFs fetch
# the 3rd party data from them on demand via API.
# Blank means the mock APIs stay private and Exasol calls them inside the VPC.
EXTERNAL_DOMAIN=

# Your IP/32 for Exasol (8563, 8443, 2581) and SSH. Blank = detected automatically.
ADMIN_CIDR=

# Sizes
EXASOL_INSTANCE=r6i.xlarge
APP_INSTANCE=t3.large
ORACLE_INSTANCE=db.t3.small

# Web app demo logins (blank = the public demo default Demo@123 for every role)
APP_ADMIN_PASSWORD=
APP_DATASCI_PASSWORD=
APP_LOANOPS_PASSWORD=
APP_RM_PASSWORD=

# Public demo. The backend (backend/app/config.py) defaults PUBLIC_DEMO to true, and the login page
# then shows the demo passwords, which is fine while all data is synthetic. Set it to false on a
# deployment with passwords of its own, so the login page shows nothing.
PUBLIC_DEMO=true

# Generative AI (optional). Use anthropic (needs ANTHROPIC_API_KEY) or bedrock (the app host's IAM
# role calls Claude in Amazon Bedrock in AWS_REGION, and the model must be enabled there). Blank turns
# the AI features off. AI_MODEL is the Anthropic API model id. BEDROCK_MODEL_ID is the Bedrock model id
# or inference profile, and blank means anthropic. followed by AI_MODEL (anthropic.claude-sonnet-5-5).
# The credit memo written inside Exasol calls the Anthropic API from a UDF, so with bedrock the
# backend writes the memo itself.
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
BEDROCK_MODEL_ID=
