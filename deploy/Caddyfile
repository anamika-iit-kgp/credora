{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	# Read-only, browsable docs of the mock external APIs (calls still need the API key).
	handle_path /mock/cibil/* {
		reverse_proxy cibil:8101
	}
	handle_path /mock/gstn/* {
		reverse_proxy gstn:8102
	}
	handle_path /mock/aa/* {
		reverse_proxy aa:8103
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# The hash is the theme script inline in frontend/index.html. Recompute it when that script changes
		# (deploy/credora.py computes it from the built page at ship time).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-GNUqH3BNIxF6ildS9Y1SPQsYk7BcYJOz6RUJ3BG/AuI='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
